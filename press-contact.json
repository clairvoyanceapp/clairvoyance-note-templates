    "preferredChannel:",
    "timezone:",
    "location:",
    "tier:",
    "temperature:",
    "---",
    "# New Contact",
    "",
    "## Background",
    "",
    "",
    "## Coverage of us",
    "",
    "",
    "## Interaction log",
    "",
    "### {date}",
    "",
    ""
  ],
  "binder": {
    "name": "New Contact",
    "baseDir": "Contacts",
    "content": [
      "filters:",
      "  and:",
      "    - 'type == \"contact\"'",
      "views:",
      "  - type: clv.binder-tree",
      "    name: Tree",
      "    x-clairvoyance:",
      "      kb:",
      "        nodes: []",
      "  - type: clv.binder-contents",
      "    name: List",
      "    x-clairvoyance:",
      "      mode: list",
      "  - type: clv.binder-contents",
      "    name: Grid",
      "    x-clairvoyance:",
      "      mode: grid",
      "  - type: clv.record-profile",
      "    name: Contact",
      "x-clairvoyance:",
      "  version: 2",
      "  defaultView: Contact",
      "  templateId: view-contact",
      "  contentType: container",
      "  itemTypes:",
      "    - contact",
      "  membership:",
      "    mode: embedded",
      "    includeItemLinks: true",
      "  resources:",
      "    records: []",
      "    linkedTodos: []",
      "    linkedBases: []",
      "  schema:",
      "    itemFields:",
      "      - name: title",
      "        type: text",
      "        label: Name",
      "        required: true",
      "      - name: email",
      "        type: text",
      "        label: Email",
      "      - name: phone",
      "        type: text",
      "        label: Phone",
      "      - name: role",
      "        type: text",
      "        label: Role / Position",
      "      - name: outlet",
      "        type: text",
      "        label: Outlet",
      "      - name: beat",
      "        type: text",
      "        label: Beat",
      "      - name: twitter",
      "        type: text",
      "        label: X/Twitter",
      "      - name: linkedin",
      "        type: text",
      "        label: LinkedIn",
      "      - name: website",
      "        type: text",
      "        label: Website / Author page",
      "      - name: preferredChannel",
      "        type: select",
      "        label: Preferred channel",
      "        options:",
      "          - email",
      "          - phone",
      "          - social",
      "      - name: timezone",
      "        type: text",
      "        label: Time zone",
      "      - name: location",
      "        type: text",
      "        label: Location",
      "      - name: tier",
      "        type: text",
      "        label: Tier",
      "      - name: temperature",
      "        type: text",
      "        label: Temperature",
      "      - name: notes",
      "        type: textarea",
      "        label: Notes",
      "        placeholder: Background, preferences, and useful context",
      "    createDialogByType:",
      "      contact:",
      "        title: New Contact",
      "        label: Add Contact",
      "        fields:",
      "          - title",
      "          - email",
      "          - phone",
      "          - notes"
    ]
  },
  "group": "collections"
}
