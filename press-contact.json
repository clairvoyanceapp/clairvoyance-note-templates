{
  "id": "press-contact",
  "version": 8,
  "name": "New Contact",
  "icon": "user",
  "noteType": "contact",
  "order": 73,
  "content": [
    "---",
    "type: contact",
    "role:",
    "outlet:",
    "beat:",
    "email:",
    "phone:",
    "twitter:",
    "linkedin:",
    "bluesky:",
